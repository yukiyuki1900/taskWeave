{
  "version": 1,
  "name": "TaskWeave v0.2 baseline: 20 small tasks",
  "config": {
    "version": 1,
    "checks": {
      "verify-add": {
        "command": "node",
        "args": [
          "--input-type=module",
          "-e",
          "import assert from \"node:assert/strict\";const m=await import(\"./answer.mjs\");assert.equal(m.add(2,3),5);assert.equal(m.add(-2,2),0);assert.equal(m.add(0,0),0)"
        ],
        "timeoutMs": 10000
      },
      "verify-trim": {
        "command": "node",
        "args": [
          "--input-type=module",
          "-e",
          "import assert from \"node:assert/strict\";const m=await import(\"./answer.mjs\");assert.equal(m.normalizeTitle(\"  a   b  \"),\"a b\");assert.equal(m.normalizeTitle(\"\"),\"\");assert.equal(m.normalizeTitle(\" x\\ny \"),\"x y\")"
        ],
        "timeoutMs": 10000
      },
      "verify-clamp": {
        "command": "node",
        "args": [
          "--input-type=module",
          "-e",
          "import assert from \"node:assert/strict\";const m=await import(\"./answer.mjs\");assert.equal(m.clamp(-1,0,10),0);assert.equal(m.clamp(11,0,10),10);assert.equal(m.clamp(5,0,10),5)"
        ],
        "timeoutMs": 10000
      },
      "verify-unique": {
        "command": "node",
        "args": [
          "--input-type=module",
          "-e",
          "import assert from \"node:assert/strict\";const m=await import(\"./answer.mjs\");assert.deepEqual(m.unique([3,1,3,2,1]),[3,1,2]);assert.deepEqual(m.unique([]),[]);assert.deepEqual(m.unique([0,0]),[0])"
        ],
        "timeoutMs": 10000
      },
      "verify-divide": {
        "command": "node",
        "args": [
          "--input-type=module",
          "-e",
          "import assert from \"node:assert/strict\";const m=await import(\"./answer.mjs\");assert.equal(m.safeDivide(6,3),2);assert.equal(m.safeDivide(1,0),null);assert.equal(m.safeDivide(0,2),0)"
        ],
        "timeoutMs": 10000
      }
    }
  },
